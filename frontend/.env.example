VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: serve product photos through the Cloudflare image Worker instead of Supabase directly.
# Leave empty to keep using Supabase. Set to e.g. https://img.rsfashions25.com to turn it on.
VITE_IMAGE_CDN_URL=

# Error monitoring (Sentry). The website sends errors to Sentry in production by default.
# Set to an empty string to turn it off, or to another DSN to override it.
VITE_SENTRY_DSN=
# Source maps (build only, keep SECRET - set in Vercel, never commit): lets Sentry show real file
# names and lines in error reports. Create an organisation token at Sentry > Settings > Auth Tokens.
SENTRY_AUTH_TOKEN=
