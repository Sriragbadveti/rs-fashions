{
  "installCommand": "npm install --prefix frontend",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "VITE_API_BASE_URL": "https://rs-fashions.onrender.com",
    "VITE_IMAGE_CDN_URL": "https://img.rsfashions25.com"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rs-fashions-d5h8.vercel.app"
        }
      ],
      "destination": "https://www.rsfashions25.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "rs-fashions.vercel.app"
        }
      ],
      "destination": "https://www.rsfashions25.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}